From 7c96a786a45828e9dd436cb1339d9791f1503b16 Mon Sep 17 00:00:00 2001
From: RivonClaw CI <ci@rivonclaw.com>
Date: Tue, 1 Sep 2026 14:02:37 -0700
Subject: [PATCH] feat(webview): let the embedding host translate office labels

Pixel Agents ships no i18n, and the four strings drawn over characters -
Idle, Needs approval, Waiting for input, Subtask - are the only
user-visible text inside the office. A host embedding the office in a
localised product currently has no way to translate them.

Read them from an optional window.__OFFICE_LABELS__ map, falling back to
the existing English literals so behaviour is unchanged when a host sets
nothing. A global rather than a protocol message because the labels have
to be in place before the first frame paints, which is earlier than any
message can arrive.
---
 .../src/office/components/ToolOverlay.tsx     | 38 +++++++++++++++----
 1 file changed, 31 insertions(+), 7 deletions(-)

diff --git a/webview-ui/src/office/components/ToolOverlay.tsx b/webview-ui/src/office/components/ToolOverlay.tsx
index 1bb1e13..424592e 100644
--- a/webview-ui/src/office/components/ToolOverlay.tsx
+++ b/webview-ui/src/office/components/ToolOverlay.tsx
@@ -27,6 +27,29 @@ import { CharacterState } from '../types.js';
 // shows ONLY the checkmark (the label falls through to its normal idle text);
 // going idle waiting on the user (Notification(idle_prompt)) additionally
 // surfaces this label. Driven by Character.waitingAwaitingInput.
+/**
+ * Host-supplied translations for the labels drawn over characters.
+ *
+ * Pixel Agents has no i18n, and these strings are the only user-visible text
+ * inside the office, so an embedding host that speaks another language has no
+ * way to localise its own product without them. Read from a global rather than
+ * added to the message protocol because the labels must be in place before the
+ * first frame paints, which is earlier than any message can arrive; the host
+ * sets it from the page URL in its bootstrap script. Every lookup falls back to
+ * the English literal, so a host that sets nothing behaves exactly as before.
+ */
+declare global {
+  interface Window {
+    __OFFICE_LABELS__?: Record<string, string>;
+  }
+}
+
+function officeLabel(key: string, fallback: string): string {
+  if (typeof window === 'undefined') return fallback;
+  const value = window.__OFFICE_LABELS__?.[key];
+  return typeof value === 'string' && value.length > 0 ? value : fallback;
+}
+
 const WAITING_INPUT_ACTIVITY_TEXT = 'Waiting for input';
 
