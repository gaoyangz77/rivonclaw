From 2b2e0f55324d352284d24537cff50eb487f12cfe Mon Sep 17 00:00:00 2001
From: RivonClaw CI <ci@rivonclaw.com>
Date: Sat, 8 Aug 2026 05:21:05 -0700
Subject: [PATCH] vendor(openclaw): expose embedded state migrations

Why:
- RivonClaw Desktop starts the embedded Gateway without the node-host runner, so retired startup and configured-workspace state otherwise remains unmigrated.
- OpenClaw v2 requires stopped-writer maintenance authority for versioned agent database migrations and no longer exposes auth migration through a stable private chunk name.
- RivonClaw must invoke OpenClaw-owned migration implementations through one stable embedded-host boundary.

Removal:
- OpenClaw exports startup, workspace, auth-profile, and maintenance-authorized agent database migration surfaces from a stable public runtime, or RivonClaw starts Gateway through a host flow that invokes all of them.

Tests:
- packages/gateway/src/vendor/state-migration.test.ts
---
 src/plugin-sdk/node-host.ts | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/plugin-sdk/node-host.ts b/src/plugin-sdk/node-host.ts
index 411c22461ed..12a96fce6ce 100644
--- a/src/plugin-sdk/node-host.ts
+++ b/src/plugin-sdk/node-host.ts
@@ -9,6 +9,13 @@ export {
   type NodePtyResumeParams,
 } from "../node-host/pty-command.js";
 export { validateClaudeSessionId } from "../node-host/invoke-agent-cli-claude-params.js";
+export { runStartupMigrations } from "../node-host/startup-state-migrations.js";
+export { maybeMigrateAuthProfileJsonStoresToSqlite } from "../commands/doctor-auth-flat-profiles.js";
+export {
+  detectLegacyWorkspaceState,
+  migrateLegacyWorkspaceState,
+} from "../infra/state-migrations.workspace-setup.js";
+export { withAgentDatabaseMaintenanceLease } from "../state/openclaw-agent-db.js";
 export type { OpenClawPluginNodeHostCommandIo } from "../plugins/types.js";
 
 /** Resolve a node-host executable using the selected PATH source policy. */
