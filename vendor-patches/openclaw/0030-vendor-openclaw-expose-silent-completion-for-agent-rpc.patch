From e952913b594472f373424a04a52a37fa66c2483c Mon Sep 17 00:00:00 2001
From: RivonClaw CI <ci@rivonclaw.com>
Date: Mon, 27 Jul 2026 12:00:26 -0700
Subject: [PATCH] vendor(openclaw): expose silent completion for agent RPC

Why:
- Customer-service agents need to accept clean empty assistant turns without changing global agent behavior.

Removal:
- Drop when upstream agent Gateway RPC forwards allowEmptyAssistantReplyAsSilent or provides an equivalent per-run option.

Tests:
- apps/desktop/src/cs-bridge/vendor-agent-silent-completion.sentinel.test.ts
- apps/desktop/src/cs-bridge/customer-service-bridge.test.ts
- apps/desktop/src/cs-bridge/cs-conversation-summary-service.test.ts
- apps/desktop/src/affiliate/affiliate-work-item.test.ts
---
 .../gateway-protocol/src/schema/agent.test.ts   | 17 +++++++++++++++++
 packages/gateway-protocol/src/schema/agent.ts   |  1 +
 .../command/attempt-execution.cli.test.ts       |  2 ++
 src/agents/command/attempt-execution.ts         |  1 +
 src/agents/command/types.ts                     |  2 ++
 src/gateway/server-methods/agent.test.ts        |  3 +++
 src/gateway/server-methods/agent.ts             |  2 ++
 7 files changed, 28 insertions(+)

diff --git a/packages/gateway-protocol/src/schema/agent.test.ts b/packages/gateway-protocol/src/schema/agent.test.ts
index bd03583bd7a..d24dba01e37 100644
--- a/packages/gateway-protocol/src/schema/agent.test.ts
+++ b/packages/gateway-protocol/src/schema/agent.test.ts
@@ -57,6 +57,23 @@ const musicCompletionEvent: AgentInternalEvent = {
 };
 
 describe("AgentParamsSchema", () => {
+  it("accepts only boolean silent empty-reply overrides", () => {
+    const params = makeAgentParamsWithInternalEvent(musicCompletionEvent);
+
+    expect(
+      Value.Check(AgentParamsSchema, {
+        ...params,
+        allowEmptyAssistantReplyAsSilent: true,
+      }),
+    ).toBe(true);
+    expect(
+      Value.Check(AgentParamsSchema, {
+        ...params,
+        allowEmptyAssistantReplyAsSilent: "true",
+      }),
+    ).toBe(false);
+  });
+
   it("accepts generated music attachments on internal completion events", () => {
     const params = makeAgentParamsWithInternalEvent(musicCompletionEvent);
 
