From 64f7d6a7aecd4e49791414771fd17eb64f139a6c Mon Sep 17 00:00:00 2001
From: RivonClaw CI <ci@rivonclaw.com>
Date: Sat, 8 Aug 2026 00:52:01 -0700
Subject: [PATCH] vendor(openclaw): expose silent completion for agent RPC

Why:
- Trusted internal RPC callers need clean empty model completions to settle as intentional silent replies.

Removal:
- Drop when upstream AgentParamsSchema and gateway execution expose allowEmptyAssistantReplyAsSilent without overriding subagent handoff behavior.

Tests:
- apps/desktop/src/cs-bridge/vendor-agent-silent-completion.sentinel.test.ts
---
 .../gateway-protocol/src/schema/agent.test.ts   | 17 +++++++++++++++++
 packages/gateway-protocol/src/schema/agent.ts   |  1 +
 .../command/attempt-execution.cli.test.ts       |  2 ++
 src/agents/command/attempt-execution.ts         |  3 ++-
 src/agents/command/types.ts                     |  2 ++
 .../agent-turn/agent-run-execution-phase.ts     |  1 +
 .../server-methods/agent-request-types.ts       |  1 +
 .../agent.events-and-subagents.test-utils.ts    |  3 +++
 8 files changed, 29 insertions(+), 1 deletion(-)

diff --git a/packages/gateway-protocol/src/schema/agent.test.ts b/packages/gateway-protocol/src/schema/agent.test.ts
index ea46d48d118..825c6a08a9f 100644
--- a/packages/gateway-protocol/src/schema/agent.test.ts
+++ b/packages/gateway-protocol/src/schema/agent.test.ts
@@ -70,6 +70,23 @@ const musicCompletionEvent: AgentInternalEvent = {
 };
 
 describe("AgentParamsSchema", () => {
+  it("accepts only boolean silent empty-reply overrides", () => {
+    const params = makeAgentParamsWithInternalEvent(musicCompletionEvent);
+
+    expect(
+      Value.Check(AgentParamsSchema, {
+        ...params,
+        allowEmptyAssistantReplyAsSilent: true,
+      }),
+    ).toBe(true);
+    expect(
+      Value.Check(AgentParamsSchema, {
+        ...params,
+        allowEmptyAssistantReplyAsSilent: "true",
+      }),
+    ).toBe(false);
+  });
+
   it("accepts the backend expected-session binding", () => {
     expect(
       Value.Check(AgentParamsSchema, {
