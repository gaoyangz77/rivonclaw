+async function retryFeishuMediaUpload<T>(upload: () => Promise<T>): Promise<T> {
+  return await retryAsync(upload, {
+    attempts: FEISHU_MEDIA_UPLOAD_ATTEMPTS,
+    minDelayMs: FEISHU_MEDIA_UPLOAD_RETRY_BASE_MS,
+    maxDelayMs: FEISHU_MEDIA_UPLOAD_RETRY_MAX_MS,
+    jitter: "full",
+    shouldRetry: isTransientNetworkError,
+  });
+}
