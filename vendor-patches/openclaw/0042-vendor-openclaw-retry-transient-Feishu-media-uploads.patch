From 6a4b7fef85274297f3251f08674c83073f3c3492 Mon Sep 17 00:00:00 2001
From: RivonClaw CI <ci@rivonclaw.com>
Date: Mon, 28 Sep 2026 10:54:07 +0800
Subject: [PATCH 42/42] vendor(openclaw): retry transient Feishu media uploads

Why:
- Feishu file and image uploads can fail with transient ECONNRESET errors before message dispatch.
- Bounded upload-only retries improve delivery without broad replay of non-idempotent message sends.

Removal:
- drop when upstream provides equivalent bounded transient retries for im/v1/files and im/v1/images while keeping permanent failures single-attempt and message dispatch single-shot.
- OpenClaw PR #104322 alone is insufficient because it intentionally leaves media uploads single-attempt.

Tests:
- extensions/feishu/src/media.test.ts
- apps/desktop/src/channels/vendor-feishu-media-upload-retry.sentinel.test.ts
---
 extensions/feishu/src/media.test.ts | 99 +++++++++++++++++++++++++++++
 extensions/feishu/src/media.ts      | 46 ++++++++++----
 2 files changed, 131 insertions(+), 14 deletions(-)

diff --git a/extensions/feishu/src/media.test.ts b/extensions/feishu/src/media.test.ts
index 6ebdd3ce2ba..08c66300154 100644
--- a/extensions/feishu/src/media.test.ts
+++ b/extensions/feishu/src/media.test.ts
@@ -303,6 +303,105 @@ describe("sendMediaFeishu msg_type routing", () => {
     expect(callData<{ msg_type?: string }>(messageCreateMock).msg_type).toBe("file");
   });
 
+  it("retries transient file upload failures before dispatching one message", async () => {
+    vi.useFakeTimers();
+    try {
+      fileCreateMock
+        .mockRejectedValueOnce(Object.assign(new Error("read ECONNRESET"), { code: "ECONNRESET" }))
+        .mockResolvedValueOnce({ code: 0, data: { file_key: "file_key_after_retry" } });
+
+      const send = sendMediaFeishu({
+        cfg: emptyConfig,
+        to: "user:ou_target",
+        mediaBuffer: Buffer.from("spreadsheet"),
+        fileName: "report.xlsx",
+      });
+      await vi.runAllTimersAsync();
+
+      await expect(send).resolves.toMatchObject({ messageId: "msg_1" });
+      expect(fileCreateMock).toHaveBeenCalledTimes(2);
+      expect(messageCreateMock).toHaveBeenCalledTimes(1);
+      expect(JSON.parse(callData<{ content?: string }>(messageCreateMock).content ?? "{}")).toEqual(
+        {
+          file_key: "file_key_after_retry",
+        },
+      );
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+
+  it("retries transient image upload failures before dispatching one message", async () => {
+    vi.useFakeTimers();
+    try {
+      imageCreateMock
+        .mockRejectedValueOnce(Object.assign(new Error("socket hang up"), { code: "EPIPE" }))
+        .mockResolvedValueOnce({ code: 0, data: { image_key: "image_key_after_retry" } });
+
+      const send = sendMediaFeishu({
+        cfg: emptyConfig,
+        to: "user:ou_target",
+        mediaBuffer: validPngImage,
+        fileName: "photo.png",
+      });
+      await vi.runAllTimersAsync();
+
+      await expect(send).resolves.toMatchObject({ messageId: "msg_1" });
+      expect(imageCreateMock).toHaveBeenCalledTimes(2);
+      expect(messageCreateMock).toHaveBeenCalledTimes(1);
+      expect(JSON.parse(callData<{ content?: string }>(messageCreateMock).content ?? "{}")).toEqual(
+        {
+          image_key: "image_key_after_retry",
+        },
+      );
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+
+  it("does not retry permanent upload failures", async () => {
+    fileCreateMock.mockRejectedValueOnce(
+      Object.assign(new Error("Request failed with status code 400"), {
+        response: { status: 400, data: { code: 234001, msg: "invalid file" } },
+      }),
+    );
+
+    await expect(
+      sendMediaFeishu({
+        cfg: emptyConfig,
+        to: "user:ou_target",
+        mediaBuffer: Buffer.from("bad-file"),
+        fileName: "report.xlsx",
+      }),
+    ).rejects.toThrow(/Feishu file upload failed/);
+    expect(fileCreateMock).toHaveBeenCalledTimes(1);
+    expect(messageCreateMock).not.toHaveBeenCalled();
+  });
+
+  it("bounds transient upload retries and never dispatches without a file key", async () => {
+    vi.useFakeTimers();
+    try {
+      fileCreateMock.mockRejectedValue(
+        Object.assign(new Error("read ECONNRESET"), { code: "ECONNRESET" }),
+      );
+
+      const send = sendMediaFeishu({
+        cfg: emptyConfig,
+        to: "user:ou_target",
+        mediaBuffer: Buffer.from("spreadsheet"),
+        fileName: "report.xlsx",
+      });
+      const rejected = expect(send).rejects.toThrow(/Feishu file upload failed/);
+      await vi.runAllTimersAsync();
+
+      await rejected;
+      expect(fileCreateMock).toHaveBeenCalledTimes(3);
+      expect(messageCreateMock).not.toHaveBeenCalled();
+    } finally {
+      vi.useRealTimers();
+    }
+  });
+
   it("uses msg_type=media for remote mp4 content even when the filename is generic", async () => {
     runFfprobeMock.mockResolvedValueOnce("6.789\n");
     loadWebMediaMock.mockResolvedValueOnce({
