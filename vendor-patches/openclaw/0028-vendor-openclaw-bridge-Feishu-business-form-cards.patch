From 6c5a5862081f53632211aeb71263a9f7a8555b1b Mon Sep 17 00:00:00 2001
From: RivonClaw CI <ci@rivonclaw.com>
Date: Fri, 21 Aug 2026 07:28:02 -0700
Subject: [PATCH] vendor(openclaw): allow trusted Feishu raw card sends

Why:
- Desktop sends CS escalation Schema 2.0 cards through the trusted Gateway action API.
- The pinned vendor accepts native cards encoded as text but does not accept the structured params.card payload required by the shared card contract.

Removal:
- Drop when upstream Feishu officially accepts operator.admin-scoped Schema 2.0 params.card sends without rewriting the payload.

Tests:
- apps/desktop/src/cs-bridge/vendor-feishu-business-form-card.sentinel.test.ts
- vendor/openclaw/extensions/feishu/src/channel.test.ts
---
 extensions/feishu/src/channel.test.ts | 67 +++++++++++++++++++++++++++
 extensions/feishu/src/channel.ts      | 29 +++++++++++-
 2 files changed, 95 insertions(+), 1 deletion(-)

diff --git a/extensions/feishu/src/channel.test.ts b/extensions/feishu/src/channel.test.ts
index 2bbc3557b75..c5466bb354a 100644
--- a/extensions/feishu/src/channel.test.ts
+++ b/extensions/feishu/src/channel.test.ts
@@ -1424,6 +1424,73 @@ describe("feishuPlugin actions", () => {
     });
   });
 
+  it("sends trusted raw Schema 2.0 cards without rewriting the payload", async () => {
+    const card = {
+      schema: "2.0",
+      body: {
+        elements: [{ tag: "form", name: "cs", elements: [{ tag: "input", name: "decision" }] }],
+      },
+    };
+    sendCardFeishuMock.mockResolvedValueOnce({ messageId: "om_form", chatId: "oc_group_1" });
+
+    const result = await feishuPlugin.actions?.handleAction?.({
+      action: "send",
+      params: { to: "chat:oc_group_1", card },
+      cfg,
+      accountId: "main",
+      gatewayClientScopes: ["operator.admin"],
+      toolContext: {},
+    } as never);
+
+    expect(sendCardFeishuMock).toHaveBeenCalledWith({
+      cfg,
+      to: "chat:oc_group_1",
+      card,
+      accountId: "main",
+      replyToMessageId: undefined,
+      replyInThread: false,
+    });
+    expect(resultDetails(result).messageId).toBe("om_form");
+  });
+
+  it.each([
+    ["non-admin", { card: { schema: "2.0", body: { elements: [{ tag: "markdown" }] } } }, []],
+    ["empty elements", { card: { schema: "2.0", body: { elements: [] } } }, ["operator.admin"]],
+    [
+      "wrong schema",
+      { card: { schema: "1.0", body: { elements: [{ tag: "markdown" }] } } },
+      ["operator.admin"],
+    ],
+    [
+      "raw card plus presentation",
+      {
+        card: { schema: "2.0", body: { elements: [{ tag: "markdown" }] } },
+        presentation: { blocks: [{ type: "text", text: "duplicate" }] },
+      },
+      ["operator.admin"],
+    ],
+    [
+      "raw card plus media",
+      {
+        card: { schema: "2.0", body: { elements: [{ tag: "markdown" }] } },
+        media: "/tmp/image.png",
+      },
+      ["operator.admin"],
+    ],
+  ])("rejects %s raw card sends", async (_label, extraParams, gatewayClientScopes) => {
+    await expect(
+      feishuPlugin.actions?.handleAction?.({
+        action: "send",
+        params: { to: "chat:oc_group_1", ...extraParams },
+        cfg,
+        accountId: "main",
+        gatewayClientScopes,
+        toolContext: {},
+      } as never),
+    ).rejects.toThrow();
+    expect(sendCardFeishuMock).not.toHaveBeenCalled();
+  });
+
   it("renders presentation buttons as native Feishu card buttons", async () => {
     sendCardFeishuMock.mockResolvedValueOnce({ messageId: "om_card", chatId: "oc_group_1" });
 
diff --git a/extensions/feishu/src/channel.ts b/extensions/feishu/src/channel.ts
index c6d09b7c015..b82cd605847 100644
--- a/extensions/feishu/src/channel.ts
+++ b/extensions/feishu/src/channel.ts
@@ -255,6 +255,26 @@ function containsLegacyFeishuCardCommandValue(node: unknown): boolean {
   return Object.values(node).some((value) => containsLegacyFeishuCardCommandValue(value));
 }
 
+function readTrustedFeishuRawCard(
+  ctx: ChannelMessageActionContext,
+): Record<string, unknown> | undefined {
+  const raw = ctx.params.card;
+  if (raw === undefined) {
+    return undefined;
+  }
+  if (!ctx.gatewayClientScopes?.includes("operator.admin")) {
+    throw new Error("Feishu raw card sending requires operator.admin.");
+  }
+  if (!isRecord(raw) || raw.schema !== "2.0" || !isRecord(raw.body)) {
+    throw new Error("Feishu raw card must be a Schema 2.0 card object with a body.");
+  }
+  const elements = raw.body.elements;
+  if (!Array.isArray(elements) || elements.length === 0) {
+    throw new Error("Feishu raw card body.elements must be a non-empty array.");
+  }
+  return raw;
+}
+
 const meta: ChannelMeta = {
   id: "feishu",
   label: "Feishu",
@@ -1249,6 +1269,13 @@ export const feishuPlugin: ChannelPlugin<ResolvedFeishuAccount, FeishuProbeResul
             // and unsupported payloads cannot silently become text-only delivery.
             const mediaUrl = resolveFeishuSendAttachmentMedia(ctx.params);
             const audioAsVoice = readBooleanParam(ctx.params, ["asVoice", "audioAsVoice"]);
+            const rawCard = readTrustedFeishuRawCard(ctx);
+            if (rawCard && presentation) {
+              throw new Error(`Feishu ${ctx.action} does not support raw card with presentation.`);
+            }
+            if (rawCard && text) {
+              throw new Error(`Feishu ${ctx.action} does not support raw card with text/message.`);
+            }
             if (textCard && !presentation) {
               assertFeishuCardWithinEnvelope(textCard, "Feishu native card");
             }
@@ -1265,7 +1292,7 @@ export const feishuPlugin: ChannelPlugin<ResolvedFeishuAccount, FeishuProbeResul
                 ? generatedCard
                 : undefined;
             const presentationFellBack = Boolean(generatedCard && !presentationCard);
-            const card = presentation ? presentationCard : textCard;
+            const card = rawCard ?? (presentation ? presentationCard : textCard);
             if (card && mediaUrl) {
               throw new Error(`Feishu ${ctx.action} does not support card with media.`);
             }
-- 
