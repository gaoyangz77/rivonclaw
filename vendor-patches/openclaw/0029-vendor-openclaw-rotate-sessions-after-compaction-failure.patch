+      blockStreamingEnabled: false,
+      resolvedBlockStreamingBreak: "message_end",
+      shouldInjectGroupIntro: false,
+      typingMode: "instant",
+    });
+
+    expect(requireRecord(result, "reply result").text).toContain(
+      "I've reset our conversation to start fresh",
