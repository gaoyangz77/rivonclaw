+    const stored = JSON.parse(await fs.readFile(storePath, "utf-8")) as Record<
+      string,
+      { sessionId?: string; sessionFile?: string }
+    >;
+    expect(stored[sessionKey]?.sessionId).not.toBe("session");
+    expect(stored[sessionKey]?.sessionFile).not.toBe(sessionFile);
+    expect(await fs.readFile(sessionFile, "utf-8")).toContain('"role":"user"');
+  });
