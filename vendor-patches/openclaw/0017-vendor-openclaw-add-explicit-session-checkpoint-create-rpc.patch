+  "sessions.checkpoint.create": async ({ params, respond, context }) => {
+    if (
+      !assertValidParams(
+        params,
+        validateSessionsCheckpointCreateParams,
+        "sessions.checkpoint.create",
+        respond,
+      )
+    ) {
+      return;
+    }
+    const key = requireSessionKey(params.key, respond);
+    if (!key) {
+      return;
+    }
+    const cfg = context.getRuntimeConfig();
+    const requestedAgent = resolveRequestedGlobalAgentId(cfg, key);
+    if (!requestedAgent.ok) {
+      respond(false, undefined, requestedAgent.error);
+      return;
+    }
+    const { entry, canonicalKey, target, storePath } = loadAccessorSessionEntryForGatewayTarget({
+      key,
+      cfg,
+      agentId: requestedAgent.agentId,
+    });
+    if (!entry?.sessionId) {
+      respond(
+        false,
+        undefined,
+        errorShape(ErrorCodes.INVALID_REQUEST, `session not found: ${key}`),
+      );
+      return;
+    }
+    const checkpoint = await persistExplicitSessionCompactionCheckpoint({
+      cfg,
+      sessionKey: canonicalKey,
+      sessionId: entry.sessionId,
+      agentId: target.agentId,
+      storePath,
+      checkpointId: params.checkpointId,
+      ...(params.summary?.trim() ? { summary: params.summary.trim() } : {}),
+      ...(typeof entry.totalTokens === "number" ? { tokensBefore: entry.totalTokens } : {}),
+    });
+    if (!checkpoint) {
+      respond(
+        false,
+        undefined,
+        errorShape(ErrorCodes.UNAVAILABLE, "failed to persist session checkpoint"),
+      );
+      return;
+    }
+    respond(
+      true,
+      { ok: true, key: canonicalKey, sessionId: entry.sessionId, checkpoint },
+      undefined,
