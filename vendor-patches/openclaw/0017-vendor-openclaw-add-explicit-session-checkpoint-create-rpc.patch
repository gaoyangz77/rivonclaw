+export async function persistExplicitSessionCompactionCheckpoint(params: {
+  cfg: OpenClawConfig;
+  sessionKey: string;
+  sessionId: string;
+  agentId: string;
+  storePath: string;
+  checkpointId: string;
+  summary?: string;
+  tokensBefore?: number;
+}): Promise<SessionCompactionCheckpoint | null> {
+  const transcriptState = await readSessionLeafStateFromTranscriptAsync({
+    agentId: params.agentId,
+    sessionId: params.sessionId,
+    sessionKey: params.sessionKey,
+    storePath: params.storePath,
+  });
+  const leafId = transcriptState?.leafId;
+  if (!leafId) {
+    return null;
+  }
+  return await persistSessionCompactionCheckpoint({
+    cfg: params.cfg,
+    sessionKey: params.sessionKey,
+    sessionId: params.sessionId,
+    agentId: params.agentId,
+    storePath: params.storePath,
+    checkpointId: params.checkpointId,
+    reason: "manual",
+    snapshot: {
+      sessionId: params.sessionId,
+      leafId,
+      ...(transcriptState.entryId ? { entryId: transcriptState.entryId } : {}),
+    },
+    ...(params.summary ? { summary: params.summary } : {}),
+    ...(typeof params.tokensBefore === "number" ? { tokensBefore: params.tokensBefore } : {}),
+    postLeafId: leafId,
+    ...(transcriptState.entryId ? { postEntryId: transcriptState.entryId } : {}),
+  });
+}
