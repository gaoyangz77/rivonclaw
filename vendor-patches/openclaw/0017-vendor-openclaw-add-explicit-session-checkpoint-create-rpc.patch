+test("sessions.checkpoint.create persists the current SQLite transcript leaf", async () => {
+  const { storePath } = await createSessionStoreDir();
+  const sessionId = "session-explicit-checkpoint";
+  await seedSessionEntry({
+    entry: sessionStoreEntry(sessionId, { totalTokens: 321 }),
+    sessionKey: "agent:main:main",
+    storePath,
+  });
+  await seedTranscriptRows({
+    sessionId,
+    sessionKey: "agent:main:main",
+    storePath,
+    totalLines: 2,
+  });
+  const rows = await loadTranscriptRows({
+    sessionId,
+    sessionKey: "agent:main:main",
+    storePath,
+  });
+  const leafId = rows.toReversed().find((row) => row.type !== "session")?.id;
+  expect(typeof leafId).toBe("string");
+  const { ws } = await openClient();
+
+  const created = await rpcReq<{
+    ok: true;
+    key: string;
+    sessionId: string;
+    checkpoint: SessionCompactionCheckpoint;
+  }>(ws, "sessions.checkpoint.create", {
+    key: "main",
+    checkpointId: "manual-before-dispatch",
+    summary: "before customer-service dispatch",
+  });
+
+  expect(created.ok).toBe(true);
+  expect(created.payload).toMatchObject({
+    key: "agent:main:main",
+    sessionId,
+    checkpoint: {
+      checkpointId: "manual-before-dispatch",
+      summary: "before customer-service dispatch",
+      tokensBefore: 321,
+      preCompaction: { leafId, entryId: leafId },
+      postCompaction: { leafId, entryId: leafId },
+    },
+  });
+  const listed = await rpcReq<{ checkpoints: SessionCompactionCheckpoint[] }>(
+    ws,
+    "sessions.compaction.list",
+    { key: "main" },
+  );
+  expect(listed.payload?.checkpoints).toEqual([
+    expect.objectContaining({ checkpointId: "manual-before-dispatch" }),
+  ]);
+  ws.close();
+});
