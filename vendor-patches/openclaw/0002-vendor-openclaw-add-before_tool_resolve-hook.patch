+import { describe, expect, it, vi } from "vitest";
+import { filterToolsWithBeforeResolveHook } from "./tool-resolve-hook.js";
+
+describe("filterToolsWithBeforeResolveHook", () => {
+  it("filters the complete tool surface with session context", async () => {
+    const runBeforeToolResolve = vi.fn(async () => ({ tools: ["read", "cloud_tool"] }));
+    const result = await filterToolsWithBeforeResolveHook({
+      tools: [{ name: "read" }, { name: "exec" }, { name: "cloud_tool" }],
+      agentId: "main",
+      sessionKey: "agent:main:feishu:default:direct:user",
+      hookRunner: {
+        hasHooks: () => true,
+        runBeforeToolResolve,
+      },
+    });
+
+    expect(result.map((tool) => tool.name)).toEqual(["read", "cloud_tool"]);
+    expect(runBeforeToolResolve).toHaveBeenCalledWith(
+      { tools: ["read", "exec", "cloud_tool"] },
+      { agentId: "main", sessionKey: "agent:main:feishu:default:direct:user" },
+    );
+  });
+
+  it("preserves tools when no hook is registered", async () => {
+    const tools = [{ name: "read" }];
+    await expect(
+      filterToolsWithBeforeResolveHook({
+        tools,
+        hookRunner: {
+          hasHooks: () => false,
+          runBeforeToolResolve: vi.fn(),
+        },
+      }),
+    ).resolves.toEqual(tools);
+  });
+});
