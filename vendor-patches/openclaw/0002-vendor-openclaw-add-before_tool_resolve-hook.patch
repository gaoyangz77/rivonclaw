@@ -0,0 +1,31 @@
+import { getGlobalHookRunner } from "../plugins/hook-runner-global.js";
+
+type ToolResolveHookRunner = {
+  hasHooks: (hookName: "before_tool_resolve") => boolean;
+  runBeforeToolResolve: (
+    event: { tools: string[] },
+    context: { agentId?: string; sessionKey?: string },
+  ) => Promise<{ tools?: string[] } | undefined>;
+};
+
+export async function filterToolsWithBeforeResolveHook<T extends { name: string }>(params: {
+  tools: readonly T[];
+  agentId?: string;
+  sessionKey?: string;
+  hookRunner?: ToolResolveHookRunner | null;
+}): Promise<T[]> {
+  const tools = [...params.tools];
+  const hookRunner = params.hookRunner ?? getGlobalHookRunner();
+  if (!hookRunner?.hasHooks("before_tool_resolve")) {
+    return tools;
+  }
+  const result = await hookRunner.runBeforeToolResolve(
+    { tools: tools.map((tool) => tool.name) },
+    { agentId: params.agentId, sessionKey: params.sessionKey },
+  );
+  if (!result?.tools) {
+    return tools;
+  }
+  const allowedToolNames = new Set(result.tools);
+  return tools.filter((tool) => allowedToolNames.has(tool.name));
+}
