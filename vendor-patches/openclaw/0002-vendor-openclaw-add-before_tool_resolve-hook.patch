--- /dev/null
+++ b/src/agents/tool-resolve-hook.test.ts
@@ -0,0 +1,36 @@
+import { describe, expect, it, vi } from "vitest";
+import { filterToolsWithBeforeResolveHook } from "./tool-resolve-hook.js";
+
+describe("filterToolsWithBeforeResolveHook", () => {
+  it("filters the complete tool surface with session context", async () => {
+    const runBeforeToolResolve = vi.fn(async () => ({ tools: ["read", "cloud_tool"] }));
+    const result = await filterToolsWithBeforeResolveHook({
+      tools: [{ name: "read" }, { name: "exec" }, { name: "cloud_tool" }],
+      agentId: "main",
+      sessionKey: "agent:main:feishu:default:direct:user",
+      hookRunner: {
+        hasHooks: () => true,
+        runBeforeToolResolve,
+      },
+    });
+
+    expect(result.map((tool) => tool.name)).toEqual(["read", "cloud_tool"]);
+    expect(runBeforeToolResolve).toHaveBeenCalledWith(
+      { tools: ["read", "exec", "cloud_tool"] },
+      { agentId: "main", sessionKey: "agent:main:feishu:default:direct:user" },
+    );
+  });
+
+  it("preserves tools when no hook is registered", async () => {
+    const tools = [{ name: "read" }];
+    await expect(
+      filterToolsWithBeforeResolveHook({
+        tools,
+        hookRunner: {
+          hasHooks: () => false,
+          runBeforeToolResolve: vi.fn(),
+        },
+      }),
+    ).resolves.toEqual(tools);
+  });
+});
diff --git a/src/agents/tool-resolve-hook.ts b/src/agents/tool-resolve-hook.ts
new file mode 100644
index 00000000000..7bb50cac051
--- /dev/null
+++ b/src/agents/tool-resolve-hook.ts
@@ -0,0 +1,31 @@
+import { getGlobalHookRunner } from "../plugins/hook-runner-global.js";
+
+type ToolResolveHookRunner = {
+  hasHooks: (hookName: "before_tool_resolve") => boolean;
+  runBeforeToolResolve: (
+    event: { tools: string[] },
+    context: { agentId?: string; sessionKey?: string },
+  ) => Promise<{ tools?: string[] } | undefined>;
+};
+
+export async function filterToolsWithBeforeResolveHook<T extends { name: string }>(params: {
+  tools: readonly T[];
+  agentId?: string;
+  sessionKey?: string;
+  hookRunner?: ToolResolveHookRunner | null;
+}): Promise<T[]> {
+  const tools = [...params.tools];
+  const hookRunner = params.hookRunner ?? getGlobalHookRunner();
+  if (!hookRunner?.hasHooks("before_tool_resolve")) {
+    return tools;
+  }
+  const result = await hookRunner.runBeforeToolResolve(
+    { tools: tools.map((tool) => tool.name) },
+    { agentId: params.agentId, sessionKey: params.sessionKey },
+  );
+  if (!result?.tools) {
+    return tools;
+  }
+  const allowedToolNames = new Set(result.tools);
+  return tools.filter((tool) => allowedToolNames.has(tool.name));
+}
