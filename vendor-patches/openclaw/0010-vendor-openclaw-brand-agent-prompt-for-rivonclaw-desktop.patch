+        toolNames: ["gateway", "openclaw", "session_status"],
+      });
+      expect(prompt).toMatch(/^You are a personal assistant running inside RivonClaw Desktop\./);
+      expect(prompt).not.toContain("config.patch");
+      expect(prompt).not.toContain("config.apply");
+      expect(prompt).not.toContain("update.run");
+      expect(prompt).not.toContain("openclaw update");
+      expect(prompt).not.toContain("## RivonClaw Desktop Updates");
+      if (promptMode === "none") {
+        expect(prompt).not.toContain("## RivonClaw Desktop Runtime");
+      } else {
+        expect(prompt).toContain("RivonClaw Desktop updater only on explicit user request");
+      }
+    },
+  );
+
   it("omits openclaw delegation guidance without the tool", () => {
     const prompt = buildAgentSystemPrompt({
       workspaceDir: "/tmp/openclaw",
