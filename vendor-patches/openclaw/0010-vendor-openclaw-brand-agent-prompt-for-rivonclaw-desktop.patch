+  it("includes Desktop-managed control guidance without a CLI quick reference", () => {
     const prompt = buildAgentSystemPrompt({
       workspaceDir: "/tmp/openclaw",
       toolNames: ["gateway"],
     });
 
-    expect(prompt).toContain("## OpenClaw Control");
+    expect(prompt).toContain("## RivonClaw Desktop Runtime");
